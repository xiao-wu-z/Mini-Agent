# 复制为 .env.production，或通过部署系统注入；启动前设置 APP_ENV=production。
COMPOSE_PROJECT_NAME=mini-agent-production
DOCKER_MYSQL_ROOT_PASSWORD=
AGENT_MYSQL_HOST=
AGENT_MYSQL_PORT=3306
AGENT_MYSQL_USER=
AGENT_MYSQL_PASSWORD=
AGENT_MYSQL_DB=mini_agent
AGENT_REDIS_ENABLED=true
AGENT_REDIS_HOST=127.0.0.1
AGENT_REDIS_PORT=6379
AGENT_REDIS_DB=0
AGENT_REDIS_PASSWORD=
AGENT_REDIS_SSL=false
AGENT_LLM_PROVIDER=anthropic
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=
AGENT_LLM_TIMEOUT=60
AGENT_LLM_MAX_TOKENS=4096
AGENT_LLM_AUTH_HEADER=x-api-key

# 会话接口的可信网关服务令牌，不是模型 API Key。
AGENT_API_TOKEN=

# 单次用户请求预算（包含模型纠错/复盘）；任务继续时不清除累计错误记录。
AGENT_REQUEST_MAX_TOKENS=64000
AGENT_REQUEST_MAX_OUTPUT_TOKENS=4096
AGENT_REQUEST_MAX_STEPS=8
AGENT_TOKEN_SAFETY_MARGIN=256
AGENT_LLM_COUNT_TOKENS=true
