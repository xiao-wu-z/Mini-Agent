# 复制为 .env.development；启动前设置 APP_ENV=development（默认）。
# 以下密码仅用于本地开发；修改后再首次启动容器。
COMPOSE_PROJECT_NAME=mini-agent-development
DOCKER_MYSQL_ROOT_PASSWORD=local_dev_root_change_me
AGENT_MYSQL_HOST=127.0.0.1
AGENT_MYSQL_PORT=3306
AGENT_MYSQL_USER=mini_agent
AGENT_MYSQL_PASSWORD=local_dev_mysql_change_me
AGENT_MYSQL_DB=mini_agent_dev

AGENT_REDIS_ENABLED=true
AGENT_REDIS_HOST=127.0.0.1
AGENT_REDIS_PORT=6379
AGENT_REDIS_DB=0
AGENT_REDIS_PASSWORD=local_dev_redis_change_me

# echo 无需联网；接入真实模型时切换为 anthropic 并填写下面三项。
AGENT_LLM_PROVIDER=echo
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=
AGENT_LLM_TIMEOUT=60
AGENT_LLM_MAX_TOKENS=4096
# 兼容服务若要求 Bearer Token，设为 authorization。
AGENT_LLM_AUTH_HEADER=x-api-key

# 单次用户请求预算（包含模型纠错/复盘）；任务继续时不清除累计错误记录。
AGENT_REQUEST_MAX_TOKENS=64000
AGENT_REQUEST_MAX_OUTPUT_TOKENS=4096
AGENT_REQUEST_MAX_STEPS=8
AGENT_TOKEN_SAFETY_MARGIN=256
AGENT_LLM_COUNT_TOKENS=true

# Context 首尾原文 + 中段滚动摘要；窗口按实际模型设置。
AGENT_CONTEXT__WINDOW_TOKENS=32000
AGENT_CONTEXT__KEEP_HEAD_UNITS=2
AGENT_CONTEXT__KEEP_TAIL_UNITS=6
AGENT_CONTEXT__SOFT_RATIO=0.70
AGENT_CONTEXT__HARD_RATIO=0.85
AGENT_CONTEXT__SUMMARY_MAX_TOKENS=1024
AGENT_CONTEXT__MIN_INTERVAL_SECONDS=60
# 大结果先持久化再返回 ref；Redis 仅作为读取缓存。
AGENT_TOOL_RESULT__INLINE_MAX_BYTES=8192
AGENT_TOOL_RESULT__PREVIEW_CHARS=256
AGENT_TOOL_RESULT__CACHE_TTL_SECONDS=3600

# 本地 Trace/Span 埋点；失败不影响业务，不记录完整 Prompt 或内部推理。
AGENT_TRACING__ENABLED=true
AGENT_TRACING__WRITE_TIMEOUT_SECONDS=0.25
AGENT_TRACING__PREVIEW_CHARS=1024
AGENT_TRACING__MAX_SPANS=512

# Chat SSE 空闲心跳，单位秒。
AGENT_SSE_HEARTBEAT_SECONDS=15
